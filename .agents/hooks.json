{
  "diwan-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content|list_dir|find_by_name|grep_search",
        "hooks": [{ "type": "command", "command": "node tools/hooks/agy.mjs", "timeout": 15 }]
      }
    ]
  }
}
