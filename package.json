{
  "name": "diwan",
  "version": "0.1.0",
  "description": "ديوان — منظومة الكتب والتحارير",
  "main": "./out/main/index.js",
  "author": "مكتب الاستنساخ المركزي",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "npm run icon && npm run build && electron-builder --dir",
    "dist": "npm run icon && npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "design": "node tools/extract-tokens.mjs && node tools/html-to-tsx.mjs",
    "tokens": "node tools/extract-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node tools/make-icon.mjs"
  },
  "build": {
    "appId": "iq.diwan.bureau",
    "productName": "Diwan",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json",
      "src/main/db/*.sql"
    ],
    "extraResources": [
      {
        "from": "resources/tessdata",
        "to": "tessdata"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "diwan-${version}-setup.${ext}",
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1025",
      "shortcutName": "ديوان",
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "docx": "^9.1.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "material-symbols": "^0.27.0",
    "parse5": "^8.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
